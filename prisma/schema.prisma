generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id                 String   @id @default(uuid())
  prescriptionNumber String?
  patientName        String?
  patientMobile      String?
  patientAddress     String?
  patientGender      String?
  patientAge         Int?
  medicines          String?
  status             String
  otp                String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  chemistId          String?
  chemistEmail       String?
}
